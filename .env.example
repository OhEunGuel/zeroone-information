# Eternal Return Open API
# 실제 키는 .env.local 에 저장하고 Git에 커밋하지 마세요 (.gitignore에 .env* 이미 포함)
ER_API_BASE=https://open-api.bser.io
ER_API_KEY=__PUT_YOUR_BSER_OPEN_API_KEY__

# 기본 시즌/팀모드 (문서 기준 정확 값으로 교체 권장)
# 예) SOLO=1, DUO=2, SQUAD=3, UNION=101 (가정 값)
ER_DEFAULT_SEASON_ID=8
ER_DEFAULT_TEAM_MODE=1

DATABASE_URL="mysql://user:pass@localhost:3306/zoi"

